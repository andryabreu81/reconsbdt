{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "recons_bdt": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/recons_bdt",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/sneat/assets/vendor/fonts/fontawesome.css",
              "src/sneat/assets/vendor/css/core.css",
              "src/sneat/assets/css/demo.css",
              "src/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css",
              "src/sneat/assets/vendor/libs/typeahead-js/typeahead.css",
              "src/sneat/assets/vendor/libs/apex-charts/apex-charts.css",
              "src/sneat/assets/vendor/libs/flatpickr/flatpickr.css"
            ],
            "scripts": [
              "src/sneat/assets/vendor/js/helpers.js",
              "src/sneat/assets/vendor/js/template-customizer.js",
              "src/sneat/assets/vendor/libs/jquery/jquery.js",
              "src/sneat/assets/vendor/libs/popper/popper.js",
              "src/sneat/assets/vendor/js/bootstrap.js",
              "src/sneat/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js",
              "src/sneat/assets/vendor/libs/flatpickr/flatpickr.js",
              "src/sneat/assets/vendor/libs/apex-charts/apexcharts.js",
              "src/sneat/assets/js/main.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mB",
                  "maximumError": "10MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "recons_bdt:build:production"
            },
            "development": {
              "buildTarget": "recons_bdt:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
