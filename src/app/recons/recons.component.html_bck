src/app/recons/recons.component.html<div class="layout-wrapper layout-content-navbar">
  <div class="layout-container">
    <!-- Layout container -->
    <div class="layout-page">
      <!-- Content wrapper -->
      <div class="content-wrapper">
        <!-- Content -->
        <div class="container-xxl flex-grow-1 container-p-y">
          <div class="row my-4">
            <div class="col">
            <div class="content-wrapper" align="left"><img [src]="logoBDT" alt="Logo BDT" width="330px"></div>
              <hr>
              <h2>Solicitud de Reconsideraciones de Reclamo</h2>
              <div class="alert alert-primary d-flex" role="alert">
                <span class="badge badge-center rounded-pill border-label-primary bg-primary p-3 me-2"><i class="fa fa-info"></i></span>
                <div class="d-flex flex-column ps-1">
                  <h6 class="alert-heading d-flex align-items-center fw-bold mb-1">Informaci&oacute;n</h6>
                  <span>Por favor complete los siguientes datos para registrar la reconsideraci&oacute;n de su reclamo.</span>
                </div>
              </div>
              <form (ngSubmit)="onSubmit()" #reconsForm="ngForm">
              <div class="accordion" id="collapsibleSection">
                <div class="card accordion-item">
                  <h2 class="accordion-header" id="headingDeliveryAddress">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapseDeliveryAddress" aria-expanded="false" aria-controls="collapseDeliveryAddress">
                      Datos de la Oficina
                    </button>
                  </h2>
                  <div id="collapseDeliveryAddress" class="accordion-collapse" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="" for="collapsible-fullname">Estado</label>
                          <select (change)="onEstadoChange()" [(ngModel)]="formRecon.state_id" id="state_id" name="state_id" class="form-control">
                            <option value="">Seleccione el estado..</option>
                            <!-- <option *ngFor="let tipo of tiposReclamo" [value]="tipo.claim_type_id">
                              {{ tipo.claim_type_name }}
                            </option> -->

                            @for (item of Estados; track item.state_id) {
                              <option value="{{ item.state_id }}">{{ item.state_id }} - {{ item.state_name }}</option>
                            }
                            @empty {
                              <option value="">{{ 'No hay estados disponibles' }}</option>
                            }

                          </select>
                        </div>
                        <div class="col-md-6">
                          <label class="" for="collapsible-fullname">Municipio</label>
                          <select (change)="onMunicipalityChange()" [(ngModel)]="formRecon.municipio_id" id="municipio_id" name="municipio_id" class="form-control">
                            <option value="">Seleccione el municipio..</option>
                            <!-- <option *ngFor="let tipo of tiposReclamo" [value]="tipo.claim_type_id">
                              {{ tipo.claim_type_name }}
                            </option> -->

                            @for (item of Municipios; track item.municipality_id) {
                              <option value="{{ item.municipality_id }}">{{ item.municipality_id }} - {{ item.municipality_name }}</option>
                            }
                            @empty {
                              <option value="">{{ 'No hay municipios disponibles' }}</option>
                            }

                          </select>
                        </div>
                      </div>
                      <br>
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="" for="collapsible-fullname">Parroquia</label>
                          <select (change)="onParroquiaChange()" [(ngModel)]="formRecon.parroquia_id" id="parroquia_id" name="parroquia_id" class="form-control">
                            <option value="">Seleccione la parroquia..</option>
                            <!-- <option *ngFor="let tipo of tiposReclamo" [value]="tipo.claim_type_id">
                              {{ tipo.claim_type_name }}
                            </option> -->

                            @for (item of Parroquias; track item.parish_id) {
                              <option value="{{ item.parish_id }}">{{ item.parish_id }} - {{ item.parish_name }}</option>
                            }
                            @empty {
                              <option value="">{{ 'No hay parroquias disponibles' }}</option>
                            }

                          </select>
                        </div>
                        <div class="col-md-6">
                          <label class="" for="collapsible-fullname">Agencia Bancaria</label>
                          <!-- <input type="number" [(ngModel)]="formRecon.codigo_agencia" id="codigo_agencia" name="codigo_agencia" class="form-control" placeholder=""> -->
                          <select  [(ngModel)]="formRecon.codigo_agencia" id="codigo_agencia" name="codigo_agencia" class="form-control">
                            <option value="">Seleccione la agencia..</option>
                            <!-- <option *ngFor="let tipo of tiposReclamo" [value]="tipo.claim_type_id">
                              {{ tipo.claim_type_name }}
                            </option> -->

                            @for (item of Agencias; track item.banking_agency_id) {
                              <option value="{{ item.banking_agency_code }}">{{ item.banking_agency_code }} - {{ item.banking_agency_name }}</option>
                            }
                            @empty {
                              <option value="">{{ 'No existen agencias disponibles' }}</option>
                            }

                          </select>
                        </div>
                        <!-- <div class="col-md-6">
                          <label class="" for="collapsible-phone">Nombre</label>
                          <input type="text" [(ngModel)]="formRecon.nombre_agencia"  id="nombre_agencia" name="nombre_agencia" class="form-control" placeholder="">
                        </div> -->
                      </div>
                    </div>
                  </div>
                </div>
                <div class="card accordion-item">
                  <h2 class="accordion-header" id="headingDeliveryOptions">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapseDeliveryOptions" aria-expanded="false" aria-controls="collapseDeliveryOptions">
                      Datos del Cliente
                    </button>
                  </h2>
                  <!-- collapse -->
                  <div id="collapseDeliveryOptions" class="accordion-collapse collapse" aria-labelledby="headingDeliveryOptions" data-bs-parent="#collapsibleSection">
                    <div class="accordion-body">
                     <div class="row g-3">
                        <div class="col-md-6">
                          <label class="" for="collapsible-fullname">Nombres y Apellidos / Razón Social</label>
                          <input type="text" [(ngModel)]="formRecon.nombre_completo" id="nombre_completo" name="nombre_completo" class="form-control" placeholder="John Doe">
                        </div>
                        <div class="col-md-3">
                          <label class="" for="collapsible-phone">N° Documento de Identificación</label>
                          <input type="number" [(ngModel)]="formRecon.cedula" id="cedula" name="cedula" class="form-control phone-mask" placeholder="12345678" aria-label="12345678">
                        </div>
                        <div class="col-md-3">
                          <label class="" for="collapsible-phone">N° RIF</label>
                          <input type="number" [(ngModel)]="formRecon.rif" id="rif" name="rif" class="form-control phone-mask" placeholder="123456789" aria-label="123456789">
                        </div>
                        <div class="col-md-6">
                          <label class="" for="collapsible-pincode">Número de Tel&eacute;fono / Local / Celular</label>
                          <input type="text" [(ngModel)]="formRecon.tlf" id="tlf" name="tlf" class="form-control" placeholder="658468">
                        </div>
                        <div class="col-md-6">
                          <label class="" for="collapsible-landmark">Correo Electrónico</label>
                          <input type="email" [(ngModel)]="formRecon.email" id="email" name="email" class="form-control" placeholder="correo@dominio.com">
                        </div>
                        <div class="col-12">
                          <label class="" for="collapsible-address">Dirección de Habitación</label>
                          <textarea name="direccion" class="form-control" [(ngModel)]="formRecon.direccion" id="direccion" rows="2" placeholder="Ejemplo: Av. Bolivar, Caracas"></textarea>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="card accordion-item">
                  <h2 class="accordion-header" id="headingPaymentMethod">
                    <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#collapsePaymentMethod" aria-expanded="false" aria-controls="collapsePaymentMethod">
                      Datos del Reclamo a ser Reconsiderado
                    </button>
                  </h2>
                  <div id="collapsePaymentMethod" class="accordion-collapse collapse" aria-labelledby="headingPaymentMethod" data-bs-parent="#collapsibleSection" >

                      <div class="accordion-body">
                        <div class="row g-3">
                          <div class="col-md-2">
                            <label class="" for="collapsible-fullname">Fecha de Reclamo</label>
                            <input type="date" [(ngModel)]="formRecon.fecha_reclamo" id="fecha_reclamo" name="fecha_reclamo" class="form-control" placeholder="John Doe">
                          </div>
                          <div class="col-md-2">
                            <label class="" for="collapsible-phone">N° de Reclamo</label>
                            <input type="number" [(ngModel)]="formRecon.num_reclamo" id="num_reclamo" name="num_reclamo" class="form-control phone-mask" placeholder="12345678" aria-label="12345678">
                          </div>
                          <div class="col-md-4">
                            <label class="" for="collapsible-phone">Tipo de Reclamo</label>

                            <div class="position-relative" data-select2-id="44">
                              <select [(ngModel)]="formRecon.tipo_reclamo" id="tipo_reclamo" name="tipo_reclamo" class="form-control">
                                <option value="">Seleccione un tipo de reclamo</option>
                                <!-- <option *ngFor="let tipo of tiposReclamo" [value]="tipo.claim_type_id">
                                  {{ tipo.claim_type_name }}
                                </option> -->

                                @for (item of tiposReclamo; track item.claim_type_id) {
                                  <option value="{{ item.claim_type_id }}">{{ item.claim_type_name }}</option>
                                }
                                @empty {
                                  <option value="">{{ 'No hay tipos de reclamos disponibles' }}</option>
                                }

                              </select>
                            </div>
                          </div>
                          <div class="col-md-2">
                            <label class="" for="collapsible-phone">Número de Referencia</label>
                            <input type="number" [(ngModel)]="formRecon.num_referencia" id="num_referencia" name="num_referencia" class="form-control phone-mask" placeholder="123456789" aria-label="123456789">
                          </div>
                          <div class="col-md-2">
                            <label class="" for="collapsible-phone">Monto</label>
                            <input type="number" [(ngModel)]="formRecon.monto" id="monto" name="monto" class="form-control phone-mask" placeholder="123456789" aria-label="123456789">
                          </div>
                        </div>
                        <br>
                        <div class="row g-3">
                          <div class="col-md-6">
                            <label class="" for="collapsible-fullname">Número de Tarjeta (Coloque la numeración completa)</label>
                            <input type="number" [(ngModel)]="formRecon.num_tarjeta" id="num_tarjeta" name="num_tarjeta" class="form-control" placeholder="">
                          </div>
                          <div class="col-md-6">
                            <label class="" for="collapsible-phone">Número de Cuenta (Coloque la numeración completa)</label>
                            <input type="number" [(ngModel)]="formRecon.num_cuenta" id="num_cuenta" name="num_cuenta" class="form-control" placeholder="">
                          </div>
                        </div>
                        <br>
                        <div class="row g-3">
                          <div class="col-md-12">
                            <label class="" for="collapsible-fullname">Descripcion clara y precisa de los hechos sucedidos. (Coloque los datos de la transaccion reclamada, lugar, fecha, hora y monto)</label>

                            <textarea rows="5" [(ngModel)]="formRecon.descripcion" name="descripcion" id="descripcion" class="form-control"></textarea>
                          </div>
                        </div>
                      <br>
                        <div align="center" class="mt-1">
                          <button style="background-color: #2A3D98; color:white;" type="submit" class="btn me-1 me-sm-3">Enviar</button>
                          <button type="reset" class="btn btn-label-secondary">Cancelar</button>
                        </div>
                        @if (registroExitoso) {
                          <div class="alert alert-success mt-4" role="alert">
                            <i class="fa fa-check-circle me-2"></i>
                            ¡Registro completado! Ahora puede descargar su comprobante en PDF.
                          </div>
                          <div class="text-center mb-4">
                            <button type="button"
                              class="btn btn-primary btn-lg"
                              (click)="generarPDFDesdeHTML()" [(ngModel)]="formRecon.cedula" [(ngModel)]="formRecon.num_reclamo"
                              style="background-color: #2A3D98; border-color: #2A3D98;color:white;">
                              <i class="fa fa-file-pdf me-2"></i>Descargar PDF
                            </button>
                          </div>
                        }

                      </div>

                  </div>
                </div>
              </div>
            </form>
            </div>
          </div>
        2025 - &copy; <a href="https://www.bdt.com.ve" target="_blank">Banco Digital de los Trabajadores</a> Banco Universal C.A. RIF: G-20009148-7 | Todos los derechos reservados
        </div>
        <!-- / Content -->

        <!-- Vista previa para PDF (oculta visualmente) -->

        <!-- se genera el PDF si se encuentras resultados de busqueda de la recons correspondiente al numero de cedula -->
           <!-- html del PDF -->
        <div
          id="pdf-preview"
          style="
            width: 210mm;
            min-height: 297mm;
            padding: 15mm;
            background: white;
            font-family: Arial, sans-serif;
            font-size: 12px;
            box-sizing: border-box;
            position: absolute;
            left: -10000px;
            top: -10000px;
          ">

          <div style="text-align: right; font-size: 10px;">
            Fecha: {{ fechaActual }}
          </div>

          <h2 style="text-align: center; margin-bottom: 20px;">
            SOLICITUD DE RECONSIDERACIÓN DE RECLAMO
          </h2>

          <!-- Datos de la Oficina -->
          <h4>Datos de la Oficina</h4>
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <tr>
              <td style="border: 1px solid #000; padding: 6px; width: 30%;"><strong>Código</strong></td>
              <td style="border: 1px solid #000; padding: 6px;"><strong>Nombre</strong></td>
            </tr>
            <tr>
              <td style="border: 1px solid #000; padding: 6px;">{{ formRecon.codigo_agencia || '—' }}</td>
              <td style="border: 1px solid #000; padding: 6px;">
                {{ formRecon.codigo_agencia || '—' }}
              </td>
            </tr>
          </table>

          <!-- Datos del Cliente -->
          <h4>Datos del Cliente</h4>
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Nombre(s) y Apellido(s) / Razón Social</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.nombre_completo || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>N° Documento de Identificación</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.cedula || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>N° RIF</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.rif || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Número(s) de Teléfono(s)</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.tlf || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Correo Electrónico</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.email || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Dirección de Habitación</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.direccion || '—' }}</td></tr>
          </table>

          <!-- Datos del Reclamo -->
          <h4>Datos del Reclamo a ser Reconsiderado</h4>
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Fecha de Reclamo</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.fecha_reclamo || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>N° de Reclamo</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.num_reclamo || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Tipo de Reclamo</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.tipo_reclamo || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>N° de Referencia</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.num_referencia || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Monto</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.monto || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Número de Tarjeta</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.num_tarjeta || '—' }}</td></tr>
            <tr><td style="border: 1px solid #000; padding: 6px;"><strong>Número de Cuenta</strong></td><td style="border: 1px solid #000; padding: 6px;">{{ formRecon.num_cuenta || '—' }}</td></tr>
          </table>

          <!-- Descripción -->
          <h4>Descripción clara y precisa de los hechos sucedidos</h4>
          <div style="border: 1px solid #000; padding: 8px; min-height: 60px;">
            {{ formRecon.descripcion || '—' }}
          </div>

          <!-- Firma -->
          <div style="margin-top: 30px; display: flex; justify-content: space-between;">
            <div>
              <p><strong>Firma / Huella del cliente</strong></p>
            </div>
            <div style="text-align: right;">
              <p><strong>Recibido por:</strong></p>
              <p>Nombres y Apellidos: ___________________</p>
              <p>Cargo: ___________________</p>
              <p>Firma / Sello de la Oficina</p>
            </div>
          </div>

          <!-- Pie de página -->
          <div style="margin-top: 20px; text-align: left; font-size: 10px;">
            FO-NA003-003-00/11-24
          </div>
        </div>



        <!-- Footer -->
        <footer class="content-footer footer bg-footer-theme">
          <div class="container-xxl d-flex flex-column flex-md-row flex-wrap justify-content-between py-2">
          </div>
        </footer>
        <!-- / Footer -->
        <div class="content-backdrop fade"></div>
      </div>
      <!-- Content wrapper -->
    </div>
    <!-- / Layout page -->
  </div>
  <!-- Overlay -->
  <div class="layout-overlay layout-menu-toggle"></div>
  <!-- Drag Target Area To SlideIn Menu On Small Screens -->
  <div class="drag-target" style="touch-action: pan-y; user-select: none; -webkit-user-drag: none; -webkit-tap-highlight-color: rgba(0, 0, 0, 0);"></div>
</div>

